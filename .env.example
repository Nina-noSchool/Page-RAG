# 复制本文件为 .env 并填写。任何 OpenAI 兼容接口都可用。
# 默认按智谱写：对话和 embedding 一个 key 全搞定。

LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=把你的key粘到这里
LLM_CHAT_MODEL=glm-4-flash
LLM_EMBED_MODEL=embedding-3

# ---- 其他常见选择（想用哪个就替换上面四行）----

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_CHAT_MODEL=gpt-4o-mini
# LLM_EMBED_MODEL=text-embedding-3-small

# 硅基流动（bge-m3 向量免费，可搭配任意对话模型）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_EMBED_MODEL=BAAI/bge-m3

# DeepSeek（注意：DeepSeek 只有对话接口，没有 embedding，
# 若对话用 DeepSeek，embedding 需另配智谱/硅基流动，需自行改 llm.py）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_CHAT_MODEL=deepseek-chat
